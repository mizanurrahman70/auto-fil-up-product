{
  "manifest_version": 3,
  "name": "Product Data Auto Filler",
  "version": "1.0.0",
  "description": "Extract product data from Technohouse and fill your admin product form. Local only, never saves for you.",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Product Data Auto Filler",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "activeTab", "scripting", "downloads"],
  "host_permissions": [
    "https://www.startech.com.bd/*",
    "https://www.ryans.com/*",
    "https://*.ryans.com/*"
  ]
}
